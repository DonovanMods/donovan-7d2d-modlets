<configs>
  <!-- v3.0: entity groups use <e n="entity"/> elements instead of text lists -->

  <!-- spawn wraiths everywhere in the wasteland -->
  <append xpath="//entitygroup[starts-with(@name,'ZombiesWasteland')]">
    <e n="zombieWraith" />
  </append>

  <!-- spawn wraiths at night (zombie groups only; wasteland is already covered above) -->
  <append xpath="//entitygroup[starts-with(@name,'Zombies') and contains(@name,'Night') and not(contains(@name,'ZombiesWasteland')) and not(contains(@name,'NightClub'))]">
    <e n="zombieWraith" />
  </append>

  <!-- add wraiths to the blood horde -->
  <append xpath="//entitygroup[starts-with(@name,'feralHordeStageGS') and e[contains(@n,'Feral')]]">
    <e n="zombieWraith" />
  </append>

  <!-- replace feral crawlers with Wraiths -->
  <append xpath="//entitygroup[e[@n='zombieSteveCrawlerFeral'] and not(e[@n='zombieWraith'])]">
    <e n="zombieWraith" />
  </append>
  <remove xpath="//entitygroup/e[starts-with(@n,'zombieSteveCrawlerFeral')]" />
</configs>
