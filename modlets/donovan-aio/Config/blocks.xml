<bundle>
  <!-- Included from donovan-betterbridges -->
  <!-- Advanced rotate -->
  <set xpath="/blocks/block[starts-with(@name, 'rollUpDoor')]/property[@name='OnlySimpleRotations']/@value">false</set>
  <set xpath="/blocks/block[starts-with(@name, 'metalReinforcedWoodDrawBridge')]/property[@name='OnlySimpleRotations']/@value">false</set>
  <!-- Included from donovan-bettertraps -->
  <set xpath="//block[@name='bladeTrap']/property[@name='Damage']/@value">40</set>
  <set xpath="//block[@name='bladeTrap']/property[@name='DamageReceived']/@value">2</set>
  <set xpath="//block[@name='electricfencepost']/property[@name='MaxDamage']/@value">500</set>
  <!-- Included from donovan-pickmeup -->
  <append xpath="/blocks/block[@name='trapSpikesWoodDmg0']">
    <property name="CanPickup" value="true" param1="trapSpikesWoodDmg0"/>
  </append>
  <append xpath="/blocks/block[@name='trapSpikesIronDmg0']">
    <property name="CanPickup" value="true" param1="trapSpikesIronDmg0"/>
  </append>
  <append xpath="/blocks/block[@name='barbedFence']">
    <property name="CanPickup" value="true"/>
  </append>
</bundle>
