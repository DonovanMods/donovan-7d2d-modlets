<configs>
  <!--
    Adds the "Donovan" preset to the Sandbox Options presets shown when starting a new game.

    The `code` attribute is generated by the game itself:
      1. Start a New Game and open the Sandbox Options window.
      2. Set the options listed in this modlet's README.
      3. Click the "Copy Code" button in the Sandbox Options window.
      4. Paste the code into the `code` attribute below and remove the
         comment markers around the <append> block.

    Until then, this modlet loads but adds nothing.
  -->

  <!--
  <append xpath="/sandbox_overrides">
    <preset name="Donovan" description="Donovan's recommended settings: boosted harvesting and crafting, more magazines and loot bags, 2x skill points" code="PASTE-CODE-HERE" default="true" />
  </append>
  -->
</configs>
