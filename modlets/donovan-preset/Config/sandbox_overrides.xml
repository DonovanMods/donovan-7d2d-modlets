<configs>
  <!--
    Adds the "Donovan" preset to the Sandbox Options presets shown when starting a new game.

    The `code` attribute is generated by the game itself: set up the options listed in
    this modlet's README in the Sandbox Options window, click "Copy Code", and paste
    the result here.
  -->

  <append xpath="/sandbox_overrides">
    <preset name="Donovan" description="Donovan's recommended settings: boosted harvesting and crafting, more magazines and loot bags, 2x skill points" code="AENCDMKDKKEHKDXKDNKDYKDTCDUDDZG" default="true" />
  </append>
</configs>
